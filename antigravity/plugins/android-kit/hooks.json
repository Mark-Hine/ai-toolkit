{
  "android-kit-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "python3 hooks/guard.py --agent antigravity", "timeout": 10 }
        ]
      }
    ]
  }
}
