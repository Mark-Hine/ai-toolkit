{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew *compile*)",
      "Bash(./gradlew *test*)",
      "Bash(./gradlew *assemble*)",
      "Bash(./gradlew *lint*)",
      "Bash(./gradlew *dependencies*)",
      "Bash(./gradlew help*)",
      "Bash(./gradlew tasks*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(android docs *)",
      "Bash(android info*)",
      "Bash(android emulator list*)",
      "Bash(android sdk list *)",
      "Bash(android skills list*)",
      "Bash(android screen *)",
      "Bash(android layout *)",
      "Bash(adb devices*)",
      "Bash(adb logcat *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Style: follow ~/.claude/rules/writing-style.md. Start with the point. No dashes or semicolons, no in-sentence colon reveals, stop when the content ends.'",
            "statusMessage": "ai-toolkit: Refresh writing preferences"
          }
        ]
      }
    ]
  }
}
