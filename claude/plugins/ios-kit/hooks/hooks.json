{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/swift_lint.py\" --agent claude"
          }
        ]
      }
    ]
  }
}
